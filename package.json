{
  "name": "sezeresim.com",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "contentlayer2 build && next dev",
    "build": "contentlayer2 build && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 .",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "typecheck": "contentlayer2 build && tsc --noEmit --incremental false",
    "test": "jest",
    "test:watch": "jest --watch",
    "postbuild": "next-sitemap --config next-sitemap.js",
    "prepare": "husky",
    "icon": "npx @svgr/cli -d src/components/Icons --ignore-existing --icon --typescript public/icons",
    "upgrade-packages": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "contentlayer2": "0.5.8",
    "date-fns": "4.4.0",
    "lucide-react": "1.64.0",
    "motion": "14.8.0",
    "next": "16.4.3",
    "next-contentlayer2": "0.5.8",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reading-time": "1.5.0",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@svgr/cli": "8.1.0",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "github-slugger": "2.0.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "lint-staged": "17.6.0",
    "next-sitemap": "4.2.3",
    "postcss": "8.5.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.5",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=100 --fix",
      "prettier -w"
    ],
    "src/**/*.{json,css,md,mdx}": [
      "prettier -w"
    ]
  }
}
